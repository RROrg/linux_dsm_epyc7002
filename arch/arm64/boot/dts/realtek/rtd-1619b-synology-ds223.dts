/dts-v1/;

#include "rtd1619b-bleedingedge.dtsi"

/ {
	compatible = "realtek,bleeding-edge", "realtek,rtd1619b";
	model = "Realtek Bleeding Edge EVB (1GB)";

	memory@4000 {
		device_type = "memory";
		reg = <0x00040000 0x7ffc0000>; /* 1 GB */
	};
	soc@0 {
		rbus: rbus@98000000 {
			npu: npu-wrapper@85000 {
				reg = <0x85000 0x2000>;
				compatible = "realtek,npu-wrapper";
				power-domains = <&pwr_npu>;
				interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&cc RTD1619B_CRT_CLK_NPU>,
					<&cc RTD1619B_CRT_PLL_HIFI>;
				clock-names = "npu", "pll_hifi";
				resets = <&pwr_npu>;
				contiguousSize = <0x0 0x1000000>;
				realtek,sb2 = <&sb2>;
				status = "okay";
			};

			ve1: ve1@40000 {
				power-domains = <&pwr_ve1>;
				resets = <&pwr_ve1>;
				reset-names = "reset";
				/delete-property/ clocks;
				/delete-property/ assigned-clocks;
				/delete-property/ assigned-clock-parents;
			};
		};
	};

	vcpu: vcpu0 {
		compatible = "realtek,rtd1319-vcpu";
		power-domains = <&pwr_ve2>;
		/delete-property/ clocks;
		/delete-property/ resets;
		/delete-property/ reset-names;
	};

	vcpu_ve3: vcpu1 {
		compatible = "realtek,rtd1319-vcpu";
		power-domains = <&pwr_ve3>;
		/delete-property/ clocks;
	};
};

&iso {
	/delete-node/ power-domain;

	dco: dco {
		compatible = "realtek,dco";
	};

	pwr_ve1: power-ve1 {
		compatible = "realtek,rtd1319-ve1-power";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		clocks = <&cc RTD1619B_CRT_CLK_VE1>;
		resets = <&cc RTD1619B_CRT_RSTN_VE1>,
			 <&cc RTD1619B_CRT_RSTN_VE1_BIST>;
		reset-names = "reset", "bist";

		assigned-clocks = <&cc RTD1619B_CRT_CLK_VE1>;
		assigned-clock-parents = <&cc RTD1619B_CRT_PLL_VE1>;
	};

	pwr_ve2: power-ve2 {
		compatible = "realtek,rtd1395-ve2-power";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		clocks = <&cc RTD1619B_CRT_CLK_VE2>;
		resets = <&cc RTD1619B_CRT_RSTN_VE2>,
			 <&cc RTD1619B_CRT_RSTN_VE2_BIST>;
		reset-names = "reset", "bist";
	};

	pwr_ve3: power-ve3 {
		compatible = "realtek,rtd1619-ve3-power";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		clocks = <&cc RTD1619B_CRT_CLK_VE3>;
	};

	pwr_gpu: power-gpu {
		compatible = "realtek,rtd1395-gpu-power";
		#power-domain-cells = <0>;
	};

	pwr_hifi0: power-hifi0 {
		compatible = "realtek,rtd1619b-hifi0-power";
		#power-domain-cells = <0>;
	};

	pwr_hifi1: power-hifi1 {
		compatible = "realtek,rtd1619b-hifi1-power";
		#power-domain-cells = <0>;
	};

	pwr_npu: power-npu {
		compatible = "realtek,rtd1619b-npu-power";
		#power-domain-cells = <0>;
		#reset-cells = <0>;
		clocks = <&cc RTD1619B_CRT_CLK_NPU>,
			 <&cc RTD1619B_CRT_CLK_HIFI>,
			 <&cc RTD1619B_CRT_CLK_EN_NPU>,
			 <&cc RTD1619B_CRT_CLK_EN_NPUPP>;
		resets = <&cc RTD1619B_CRT_RSTN_SOFT_NPU>,
			 <&cc RTD1619B_CRT_RSTN_NPU_BIST>;
		reset-names = "auto", "bist";
	};
};

&pcie1 {
	status = "disabled";
};

&pcie2 {
	status = "disabled";
};

&sata_phy {
	status = "okay";
};

&sata_phy0 {
	tx-drv = <0x40ab2001>, <0x40ab6001>, <0x40aba001>,
	         <0x12601a01>, <0x12605a01>, <0x126b9a01>;
	status = "okay";
};

&sata_phy1 {
	tx-drv = <0x40ab2001>, <0x40ab6001>, <0x40ada001>,
	         <0x12601a01>, <0x12605a01>, <0x126a9a01>;
	status = "okay";
};

&ahci_sata {
	hostinit-mode = <1>;
	status = "okay";
};

&sata_port0 {
	status = "okay";
};

&sata_port1 {
	status = "okay";
};

&rtk_pm {
	wakeup-flags = <(LAN | GPIO | RTC | TIMER | CEC)>;
	wakeup-gpio-list = <26 GPIO_WAKEUP_ENABLE GPIO_WAKEUP_ACTIVE_HIGH>;
	wakeup-timer = <0>;
	status = "okay";
};

&i2c_1 {
	rtc@68 {
		compatible = "pericom,pt7c4337";
		reg = <0x68>;
		wakeup-source;
	};
};

&protected_mem {
	status = "disabled";
};

&rpc_comm {
	status = "disabled";
};

&rpc_ringbuf {
	status = "disabled";
};

&video_fw_ve3 {
	status = "disabled";
};

&audio_heap {
	status = "disabled";
};

&media_heap {
	status = "disabled";
};

&cma_resrved_1 {
	status = "disabled";
};

&cma_resrved_2 {
	status = "disabled";
};

&cma_resrved_3 {
	status = "disabled";
};

&cma_resrved_4 {
	status = "disabled";
};

&cma_resrved_5 {
	status = "disabled";
};

&cma_resrved_6 {
	status = "disabled";
};

&cma_resrved_7 {
	status = "disabled";
};

&cma_resrved_8 {
	status = "disabled";
};

&cma_resrved_9 {
	status = "disabled";
};

&rtk_ion {
	status = "disabled";
};

&tee {
	status = "disabled";
};

&hifi {
	status = "disabled";
};

&nic {
	led-cfg = <0x17000F00>;
	eee = <0>; /* 0: disable, 1: enable */
};

&rpc {
	status = "disabled";
};

&rtk_fw_pm {
	status = "disabled";
};

&reserved_memory {
       ramoops@22000000  {
               compatible = "ramoops";
               reg = <0x22000000 0x00200000>;
               console-size = <0x00100000>;
               record-size = <0x00004000>;
               ftrace-size = <0x00004000>;
       };
};
